# Every setting Athena reads, with its default. Copy this file to .env (git
# ignores it) and fill in the required values, or let scripts\setup-local.cmd
# do it. Never commit real values. Docker Compose passes this file to the app;
# on Render and other hosts, set the same names in the dashboard. README.md,
# "Environment variables", has the full description of each one.

# ---------------------------------------------------------------- required

# The database's owner. At startup it creates or upgrades the tables and the
# app's own role below, and nothing else. On your PC: postgres and its password.
DB_OWNER_USERNAME=postgres
DB_OWNER_PASSWORD=

# The role the app connects as: it may read and add rows and change only
# balances, statuses and passwords, never the ledger or the audit log. The app
# creates it at startup with this password; use any long random value.
# (To run as one user instead, delete the two DB_OWNER_ lines and put that
# user here; Athena then has no restricted role.)
DB_USERNAME=athena_app
DB_PASSWORD=

# Base64 of at least 32 random bytes. Generate one in Windows CMD:
#   powershell -Command "$b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)"
JWT_SECRET=

# ---------------------------------------------------------------- demo users

# admin@, auditor@, alice@ and bob@athena.demo. To create them, set
# DEMO_DATA_ENABLED=true and fill all three passwords: at least 12 characters
# with a letter and a digit (the app refuses to start otherwise). Keep it
# false in a real deployment unless you want the demo accounts there.
DEMO_DATA_ENABLED=false
DEMO_ADMIN_PASSWORD=
DEMO_AUDITOR_PASSWORD=
DEMO_USER_PASSWORD=

# ---------------------------------------------------------------- optional
# Remove the leading "# " only to change a default. An empty value is not the
# same as the default and stops the app from starting.

# Database location. Docker Compose sets DB_URL and the roles itself.
# DB_URL=jdbc:postgresql://localhost:5432/athena
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=athena

# Shared counters for rate limits and sign-in throttling, so every server
# instance enforces the same limits. Render sets it from its Key Value
# service and Docker Compose from its redis service. Unset (a developer's PC),
# each server counts in its own memory and the log says so.
# REDIS_URL=redis://localhost:6379
# REDIS_TIMEOUT_MS=1000

# First administrator: created at startup only while no administrator exists,
# otherwise ignored. scripts\bootstrap-admin.cmd asks for these instead, so
# nothing is saved. If you set them here or on a host, remove the password
# after the first start.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Athena Administrator
# Prepare the database (and create the administrator, if asked), then exit.
# The bootstrap scripts set it for their one run; leave it unset here.
# BOOTSTRAP_ONLY=false

# HTTP port (Render and similar hosts set PORT themselves)
# PORT=8080

# "native" only behind a TLS proxy such as Render's; Docker Compose forces "none"
# FORWARD_HEADERS_STRATEGY=none

# Website addresses allowed to call the API from a browser, only when the
# website is hosted elsewhere, for example https://athena.vercel.app
# CORS_ALLOWED_ORIGINS=

# Access token lifetime in milliseconds (15 minutes)
# JWT_EXPIRATION_MS=900000

# Abuse protection, per client IP unless stated otherwise
# API_RATE_LIMIT_PER_MINUTE=600
# REGISTRATION_LIMIT_PER_HOUR=50
# LOGIN_MAX_FAILURES_PER_ACCOUNT_AND_IP=5
# LOGIN_MAX_FAILURES_PER_IP=30
# LOGIN_MAX_FAILURES_PER_ACCOUNT=50
# LOGIN_LOCKOUT_MINUTES=15
# MAX_REQUEST_BYTES=16384

# Log every SQL statement (development only)
# SHOW_SQL=false
