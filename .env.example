# Copy to .env (git ignores it) and fill in. Never commit real values.
# Every variable is described in README.md, section "Environment variables".

# PostgreSQL password (docker compose creates the database with it)
DB_PASSWORD=

# Base64 of at least 32 random bytes. Generate one in Windows CMD:
#   powershell -Command "$b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)"
JWT_SECRET=

# Website addresses allowed to call the API from a browser, only when the
# website is hosted elsewhere (for example https://athena.vercel.app).
CORS_ALLOWED_ORIGINS=

# Demo users (admin@, auditor@, alice@, bob@athena.demo). Each password:
# at least 12 characters with a letter and a digit.
DEMO_DATA_ENABLED=true
DEMO_ADMIN_PASSWORD=
DEMO_AUDITOR_PASSWORD=
DEMO_USER_PASSWORD=
