# Copy to .env.local for a local build that talks to a separate API, or set
# the same variable in Vercel: Project Settings > Environment Variables.
#
# Where the Spring Boot API runs. Leave it unset when the API is on the same
# origin (Vite proxy in development, or the backend serving this app).
# "/api" is added if you leave it off. Must be https:// except on localhost.
VITE_API_BASE_URL=https://your-api.onrender.com

# Development only: where `npm run dev` and `npm run preview` forward /api.
# VITE_API_PROXY_TARGET=http://localhost:8080
