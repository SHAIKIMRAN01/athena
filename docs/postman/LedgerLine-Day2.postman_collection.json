                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bobEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2 - Move money",
      "item": [
        {
          "name": "Deposit 1000.00",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const tx = pm.response.json();",
                  "pm.test(\"deposit completed\", () => { pm.expect(tx.type).to.eql(\"DEPOSIT\"); pm.expect(tx.status).to.eql(\"COMPLETED\"); });",
                  "pm.test(\"Alice now has 1000.00\", () => pm.expect(tx.balanceAfter).to.eql(1000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "deposit"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
